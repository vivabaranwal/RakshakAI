# Groq API key — required for clause analysis and the legal assistant.
# Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of origins allowed to call this API.
# In production set this to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres connection string. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/rakshak

# Directory for uploaded PDFs. Point at a mounted volume in production.
# UPLOAD_DIR=/var/data/uploads

# Max upload size in bytes (default 15 MB)
# MAX_UPLOAD_BYTES=15728640
